rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The shared sea: anyone may look at the newest krathongs and float one of their own.
    // A krathong is a kind, a colour, a time, a throwaway tag, and (only if its owner agreed) a short wish.
    // There is never a name or anything that says whose it is.
    match /krathongs/{id} {
      allow read: if request.query.limit <= 120;
      allow create: if request.resource.data.keys().hasOnly(['s', 'l', 't', 'c', 'w'])
        && request.resource.data.keys().hasAll(['s', 'l', 't', 'c'])
        && request.resource.data.s in ['banana', 'lotus', 'bread', 'coconut', 'gold', 'moon', 'swan']
        && request.resource.data.l is string
        && request.resource.data.l.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.c is string
        && request.resource.data.c.size() <= 24
        && (!('w' in request.resource.data) || (request.resource.data.w is string && request.resource.data.w.size() <= 80))
        && request.resource.data.t is int
        && request.resource.data.t > request.time.toMillis() - 600000
        && request.resource.data.t < request.time.toMillis() + 600000;
      allow update, delete: if false;
    }

    // Messages and transfer slips for the creator. Visitors can only add; only the creator (signed in on admin.html) can read.
    function isCreator() {
      return request.auth != null && request.auth.token.email == 'wachiraya.chrs@gmail.com';
    }
    match /notes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['m', 't'])
        && request.resource.data.m is string
        && request.resource.data.m.size() > 0 && request.resource.data.m.size() <= 500
        && request.resource.data.t is int
        && request.resource.data.t > request.time.toMillis() - 600000
        && request.resource.data.t < request.time.toMillis() + 600000;
      allow read, delete: if isCreator();
      allow update: if false;
    }
    match /slips/{id} {
      allow create: if request.resource.data.keys().hasOnly(['m', 't', 'i'])
        && request.resource.data.keys().hasAll(['t', 'i'])
        && request.resource.data.m is string && request.resource.data.m.size() <= 500
        && request.resource.data.i is string
        && request.resource.data.i.size() <= 800000
        && request.resource.data.t is int
        && request.resource.data.t > request.time.toMillis() - 600000
        && request.resource.data.t < request.time.toMillis() + 600000;
      allow read, delete: if isCreator();
      allow update: if false;
    }

    // How many krathongs (k) and lanterns (l) everyone has floated, and how many people (v) have come to the fair. Anyone may add one at a time; nobody can lower it or set it.
    function step(field) {
      return request.resource.data.get(field, 0) is int
        && request.resource.data.get(field, 0) - resource.data.get(field, 0) >= 0
        && request.resource.data.get(field, 0) - resource.data.get(field, 0) <= 1;
    }
    match /stats/total {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['k', 'l', 'v'])
        && request.resource.data.get('k', 0) is int && request.resource.data.get('k', 0) >= 0 && request.resource.data.get('k', 0) <= 1
        && request.resource.data.get('l', 0) is int && request.resource.data.get('l', 0) >= 0 && request.resource.data.get('l', 0) <= 1
        && request.resource.data.get('v', 0) is int && request.resource.data.get('v', 0) >= 0 && request.resource.data.get('v', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['k', 'l', 'v']) && step('k') && step('l') && step('v');
      allow delete: if false;
    }
  }
}
